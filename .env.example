# ── Vercel deployment (api/*) ─────────────────────────────────────────
# Mailchimp API key (with datacenter suffix, e.g. xxxx-us18).
# Used by: api/newsletters.js, api/campaign.js, api/article-page.js, api/sitemap.js
MAILCHIMP_API_KEY=
# Optional — defaults to the Engage Colorado list (3baceb2cd8).
MAILCHIMP_LIST_ID=

# CV Central Database (project ebymnydncfxtbeoyugsc) — signatories writes.
# Used by: api/add-signatory.js
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
