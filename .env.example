# ── Vercel deployment (api/*) ─────────────────────────────────────────
# Mailchimp API key (with datacenter suffix, e.g. xxxx-us18).
# Used by: api/newsletters.js, api/campaign.js, api/article-page.js, api/sitemap.js
MAILCHIMP_API_KEY=
# Optional — defaults to the Engage Colorado list (3baceb2cd8).
MAILCHIMP_LIST_ID=

# CV Central Database (project ebymnydncfxtbeoyugsc) — signatories writes.
# Used by: api/add-signatory.js
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Homepage content editor (/edit → api/save-section.js).
# EC_EDIT_TOKEN is the editor passphrase checked server-side.
EC_EDIT_TOKEN=

# Service role key from Supabase project llnmuexkqbchmyzneiey
# (Caruso Ventures Directory). Required by api/save-section.js for editor saves.
SUPABASE_TECH_DIR_KEY=
