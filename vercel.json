{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "thehonestassessment.com" }], "destination": "https://www.engagecolorado.org/honest-assessment", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.thehonestassessment.com" }], "destination": "https://www.engagecolorado.org/honest-assessment", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "visionforcolorado.org" }], "destination": "https://www.engagecolorado.org/vision", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.visionforcolorado.org" }], "destination": "https://www.engagecolorado.org/vision", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "ensuringcolorado.com" }], "destination": "https://www.engagecolorado.org/ensuring-colorado", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.ensuringcolorado.com" }], "destination": "https://www.engagecolorado.org/ensuring-colorado", "permanent": true }
  ],
  "rewrites": [
    { "source": "/tech-directory", "destination": "/investor-directory" },
    { "source": "/articles/:slug", "destination": "/api/article-page?slug=:slug" },
    { "source": "/article.html", "destination": "/api/article-page" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ]
}
